# Demo mode is the safe default and never calls Toast.
TOAST_MCP_MODE=demo
TOAST_MCP_TRANSPORT=stdio

# HTTP defaults to loopback. Public deployments must set explicit allowlists.
TOAST_MCP_HOST=127.0.0.1
TOAST_MCP_PORT=3000
TOAST_MCP_ALLOWED_HOSTS=
TOAST_MCP_ALLOWED_ORIGINS=

# Required only when TOAST_MCP_MODE=live.
TOAST_API_ACCESS_URL=
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUIDS=
