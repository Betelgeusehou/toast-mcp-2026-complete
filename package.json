{
  "name": "@busybee3333/toast-mcp-server",
  "version": "2.0.0-beta.1",
  "description": "Contract-verified, read-only MCP server and demo app for Toast restaurant operations",
  "type": "module",
  "main": "dist/src/main.js",
  "types": "dist/src/main.d.ts",
  "bin": {
    "toast-mcp-server": "./dist/src/main.js"
  },
  "files": [
    "dist",
    "contracts/toast-api-manifest.json",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run clean && npm run build:ui && npm run build:server",
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "start:http": "TOAST_MCP_TRANSPORT=http node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run --pool=forks --maxWorkers=1",
    "test:watch": "vitest",
    "contract:check": "tsx scripts/check-toast-contracts.ts",
    "package:check": "npm pack --dry-run",
    "check": "npm run typecheck && npm test && npm run build && npm run package:check",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "mcp-apps",
    "toast",
    "restaurant",
    "pos",
    "model-context-protocol"
  ],
  "author": "BusyBee3333",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BusyBee3333/toast-mcp-2026-complete.git"
  },
  "bugs": {
    "url": "https://github.com/BusyBee3333/toast-mcp-2026-complete/issues"
  },
  "homepage": "https://github.com/BusyBee3333/toast-mcp-2026-complete#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
